generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Operator {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at")

  acknowledgedAlarms Alarm[]
  operatorLogs       OperatorLog[]
  outgoingHandovers  ShiftHandover[] @relation("HandoverOutgoing")
  incomingHandovers  ShiftHandover[] @relation("HandoverIncoming")
  createdHandovers   ShiftHandover[] @relation("HandoverCreator")

  @@map("operators")
}

model MachineEvent {
  id          BigInt   @id @default(autoincrement())
  v           Int
  ts          DateTime @db.DateTime(3)
  runId       BigInt   @map("run_id")
  machine     String   @db.VarChar(64)
  productName String?  @map("product_name") @db.VarChar(64)
  event       String   @db.VarChar(64)
  detail      String?  @db.Text
  gear        String?  @db.VarChar(16)
  conveyor    String?  @db.VarChar(16)
  output      String?  @db.VarChar(16)
  oee         Float?

  @@index([machine, ts])
  @@index([runId])
  @@map("machine_events")
}

model OeeSummary {
  id             BigInt   @id @default(autoincrement())
  v              Int
  ts             DateTime @db.DateTime(3)
  runId          BigInt   @map("run_id")
  machine        String   @db.VarChar(64)
  product        String?  @db.VarChar(64)
  availability   Float?
  performance    Float?
  quality        Float?
  oee            Float?
  total          Int?
  good           Int?
  defect         Int?
  elapsedS       Int?     @map("elapsed_s")
  downtimeS      Int?     @map("downtime_s")
  setupS         Int?     @map("setup_s")
  runtimeS       Int?     @map("runtime_s")
  plannedTimeMin Int?     @map("planned_time_min")
  idealCycleS    Float?   @map("ideal_cycle_s")

  @@index([machine, ts])
  @@index([runId])
  @@map("oee_summaries")
}

enum AlarmSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlarmStatus {
  raised
  acknowledged
  cleared
}

model Alarm {
  id       BigInt        @id @default(autoincrement())
  // Stable identifier for the rule that raised this alarm (e.g. "gear_down").
  // Together with machine + runId it defines the dedupe key for an open alarm.
  ruleKey  String        @map("rule_key") @db.VarChar(64)
  severity AlarmSeverity
  status   AlarmStatus   @default(raised)
  machine  String        @db.VarChar(64)
  product  String?       @db.VarChar(64)
  runId    BigInt?       @map("run_id")
  title    String        @db.VarChar(255)
  detail   String?       @db.Text

  raisedAt       DateTime  @default(now()) @map("raised_at") @db.DateTime(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.DateTime(3)
  clearedAt      DateTime? @map("cleared_at") @db.DateTime(3)

  acknowledgedById Int?      @map("acknowledged_by_id")
  acknowledgedBy   Operator? @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  // Only one open (raised/acknowledged) alarm per rule+machine+run at a time;
  // enforced in code since MySQL cannot express a partial unique index.
  @@index([machine, ruleKey, status])
  @@index([status, raisedAt])
  @@map("alarms")
}

// Free-form notes operators keep about the plant (maintenance done, equipment
// shut down, ...). Separate from alarms: nothing here is raised by the worker.
model OperatorLog {
  id        BigInt   @id @default(autoincrement())
  eventTime DateTime @map("event_time") @db.DateTime(3)
  area      String   @db.VarChar(64)
  machine   String?  @db.VarChar(64)
  category  String   @db.VarChar(32)
  priority  String?  @db.VarChar(16)
  status    String   @default("Open") @db.VarChar(16)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  createdById Int?      @map("created_by_id")
  createdBy   Operator? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  handoverLinks ShiftHandoverLog[]

  @@index([eventTime])
  @@map("operator_logs")
}

// An end-of-shift handover from the outgoing operator to the incoming one. The
// outgoing and incoming operators are also the two approvers.
model ShiftHandover {
  id        BigInt    @id @default(autoincrement())
  area      String    @db.VarChar(64)
  machine   String?   @db.VarChar(64)
  // On-Going -> Open for Approval -> Completed, or Rejected (editable again).
  status    String    @default("On-Going") @db.VarChar(24)
  // When "Start Handover" was selected.
  startTime DateTime  @map("start_time") @db.DateTime(3)
  // Set when both approvers approve.
  endTime   DateTime? @map("end_time") @db.DateTime(3)

  summary      String? @db.Text
  healthSafety String? @map("health_safety") @db.Text
  checklist    Json?

  // "approved" or "rejected"; null until that person decides.
  outgoingDecision String? @map("outgoing_decision") @db.VarChar(16)
  incomingDecision String? @map("incoming_decision") @db.VarChar(16)

  outgoingId  Int?      @map("outgoing_operator_id")
  incomingId  Int?      @map("incoming_operator_id")
  createdById Int?      @map("created_by_id")
  outgoing    Operator? @relation("HandoverOutgoing", fields: [outgoingId], references: [id], onDelete: SetNull)
  incoming    Operator? @relation("HandoverIncoming", fields: [incomingId], references: [id], onDelete: SetNull)
  createdBy   Operator? @relation("HandoverCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  logs        ShiftHandoverLog[]
  attachments ShiftHandoverAttachment[]

  @@index([startTime])
  @@map("shift_handovers")
}

// Operator-log entries included in a handover.
model ShiftHandoverLog {
  handoverId BigInt @map("handover_id")
  logId      BigInt @map("log_id")

  handover ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  log      OperatorLog   @relation(fields: [logId], references: [id], onDelete: Restrict)

  @@id([handoverId, logId])
  @@index([logId])
  @@map("shift_handover_logs")
}

// Files stored in the database (capped in code; see lib/shift-handover.ts).
model ShiftHandoverAttachment {
  id         BigInt   @id @default(autoincrement())
  handoverId BigInt   @map("handover_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(127)
  size       Int
  data       Bytes    @db.LongBlob
  comment    String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  handover ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId])
  @@map("shift_handover_attachments")
}
